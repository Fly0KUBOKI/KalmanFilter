#pragma once

#include "../Lib/Matrix/fixed_matrix.hpp"

namespace ekf {
namespace linear {

using cm = cmath_fx::FixedMatrix;

// EKF線形更新ステップ
// [x_upd, P_upd] = ekf_linear_update(x, P, z, H, R)
// 
// Input:
//   x: 状態ベクトル (Nx1)
//   P: 共分散行列 (NxN)
//   z: 観測値 (Mx1)
//   H: 観測行列 (MxN)
//   R: 観測ノイズ共分散 (MxM)
//
// Output:
//   x_upd: 更新後の状態 (Nx1)
//   P_upd: 更新後の共分散 (NxN)
//
// Implementation: Src/EKF/ekf_linear_update.cpp

void ekf_linear_update(
    const cm& x,
    const cm& P,
    const cm& z,
    const cm& H,
    const cm& R,
    cm& x_upd,
    cm& P_upd
);

} // namespace linear
} // namespace ekf
